# Copy to .env.local and fill in. Never commit real values.
# All EXPO_PUBLIC_* vars are embedded in the client bundle — only put
# publishable/anon keys here, never service-role or server secrets.

# --- Supabase (required) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# --- Expo / push (required for notifications) ---
EXPO_PUBLIC_PROJECT_ID=YOUR_EXPO_PROJECT_ID

# --- RevenueCat (Stashbox+ subscriptions) ---
# Public SDK keys from app.revenuecat.com → Project → API keys.
# Absent → app runs on the free tier (no paywall).
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# --- Sentry (crash reporting) ---
# Public DSN. Absent → no crash reporting. Full native symbolication also
# needs the @sentry/react-native config plugin + auth token at build time
# (run: npx @sentry/wizard -i reactNative).
EXPO_PUBLIC_SENTRY_DSN=

# --- PostHog (product analytics) ---
# Absent → analytics no-op. Host defaults to US cloud.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
